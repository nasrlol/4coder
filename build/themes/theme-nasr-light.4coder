//- light theme: Rosé Pine Dawn, same layout as theme-nasr.4coder
//  Mostly monochrome like the dark theme: text tones (575279 / darker 3E3A5C
//  for functions, types, constants), one accent (love B4637A) for keywords
//  and preprocessor, darkened iris (7A6496) for macros, muted mauve for
//  strings, faded comments.
//  base FAF4ED  surface FFFAF3  overlay F2E9E1  hl-low F4EDE8  hl-med DFDAD9  hl-high CECACD
//  text 575279  subtle 797593  muted 9893A5
//  love B4637A  gold EA9D34  rose D7827E  pine 286983  foam 56949F  iris 907AA9

defcolor_back                       =  0xFFFAF4ED;
defcolor_back_cycle                 = {0x10575279,  0x0C575279};

defcolor_margin                     =  0xFFF2E9E1;
defcolor_margin_hover               =  0xFFCECACD;
defcolor_margin_active              =  defcolor_margin_hover;
defcolor_list_item                  = {defcolor_margin, defcolor_back};
defcolor_list_item_hover            = {defcolor_margin_hover, defcolor_margin};
defcolor_list_item_active           = {defcolor_margin_active, defcolor_margin_active};

defcolor_cursor                     = { 0xFF575279, 0xFFB4637A };

defcolor_at_cursor                  = 0xFFFAF4ED;

nasr_vim_cursor_normal              = 0xFF575279;
nasr_vim_cursor_insert              = 0xFF797593;

nasr_vim_cursor_visual              = 0xFFB4637A;

nasr_mark_color                     = 0xFF8F4A5E;
nasr_cursor_inactive                = 0x66575279;

defcolor_highlight_cursor_line      = 0xFFEEE4DC;

defcolor_mark                       = 0xFF8F4A5E;
defcolor_highlight                  = 0xFFC4BCC6;
defcolor_at_highlight               = 0xFF3E3A5C;


defcolor_text_default               =  0xFF575279;
defcolor_text_cycle                 = {0xFF575279, 0xFF797593, 0xFF9893A5, 0xFF3E3A5C};

defcolor_comment                    =  0xFF9893A5;
defcolor_comment_pop                = {0xFFB4637A, 0xFF575279};

defcolor_str_constant               =  0xFF966C86;
defcolor_char_constant              =  defcolor_str_constant;

defcolor_include                    =  defcolor_str_constant;
defcolor_int_constant               =  0xFF3E3A5C;

defcolor_float_constant             =  defcolor_int_constant;
defcolor_bool_constant              =  defcolor_int_constant;
defcolor_preproc                    =  defcolor_keyword;
defcolor_special_character          =  0xFFB4637A;
defcolor_ghost_character            =  0xFFCECACD;

defcolor_paste                      =  0xFFC9822A;
defcolor_undo                       =  0xFF8F4A5E;

defcolor_highlight_junk             =  0xFFE3C4C6;
defcolor_highlight_white            =  0xFFE6DCD3;

defcolor_line_numbers_back          =  0x00F2E9E1;
defcolor_line_numbers_text          =  0xFF9893A5;

defcolor_type                       = 0xFF3E3A5C;
defcolor_keyword                    = 0xFFB4637A;
defcolor_struct                     = defcolor_type;
defcolor_primitive                  = defcolor_type;
defcolor_enum                       = defcolor_int_constant;
defcolor_global                     = defcolor_text_default;
defcolor_control                    = defcolor_keyword;
defcolor_function                   = 0xFF3E3A5C;
defcolor_macro                      = 0xFF7A6496;
defcolor_non_text                   = 0xFF797593;

defcolor_vim_filebar_pop            =  0xFF575279;
defcolor_bar                        =  0xFF575279;
defcolor_base                       =  0xFFFAF4ED;
defcolor_pop1                       =  0xFFB4637A;
defcolor_pop2                       =  0xFF8F4A5E;



defcolor_vim_chord_text             =  defcolor_text_default;
defcolor_vim_chord_unresolved       =  defcolor_mark;
defcolor_vim_chord_error            =  0xFFB4637A;
